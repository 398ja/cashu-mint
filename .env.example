# Production environment for docker-compose.prod.yml
#
# Copy to `.env`, fill in real values, and keep it out of version control (.env is gitignored).
# Every variable below is REQUIRED: the stack refuses to start rather than fall back to a
# known-value default. That is deliberate. The 2026-09-05 audit found the previous file shipped
# `postgres`/`postgres` and a dev-mode Vault root token as working defaults.
#
# Generate each secret with: openssl rand -hex 32

# --- Databases -------------------------------------------------------------------------------
# One role, four databases. Ports are not published; use `docker compose exec` for admin access.
POSTGRES_USER=cashu
VAULT_DB_PASSWORD=
GATEWAY_DB_PASSWORD=
ADMIN_DB_PASSWORD=
MINT_DB_PASSWORD=

# --- HashiCorp Vault -------------------------------------------------------------------------
# Vault runs in server mode against ./vault/config/vault.hcl and must be unsealed (or configured
# for auto-unseal) before the stack is usable. VAULT_INIT_TOKEN is a SHORT-LIVED provisioning
# token used only by the one-shot `vault-init` job; revoke it once the job has run. It is not
# the credential the application uses.
# http matches vault/config/vault.hcl, whose listener sets tls_disable = 1 because the port is
# not published and only the mint and vault service reach it on the private `cashu` network.
# Moving to vault-tls.hcl means changing this, VAULT_HASHI_URI and the compose healthcheck
# together: a healthcheck speaking the wrong scheme never passes, and every dependent service
# then waits for ever.
VAULT_ADDR=http://hashicorp-vault:8200
VAULT_INIT_TOKEN=
VAULT_HASHI_ENGINE_MOUNT=cashu

# AppRole credentials for cashu-vault-jpa. The role-id is written to the vault-data volume by
# the init job; the secret-id is response-wrapped there and must be unwrapped once. Never set
# these to a root token.
VAULT_HASHI_ROLE_ID=
VAULT_HASHI_SECRET_ID=

# Bearer token for the cashu-vault REST API. The vault stores proof secrets and keyset material
# and refuses to start without this; the mint and the admin service present it on every call.
VAULT_API_TOKEN=

# --- Mint ------------------------------------------------------------------------------------
# MINT_WEBHOOK_SECRET is the HMAC key for payment-adapter webhook deliveries. The mint refuses
# to start without it in non-local profiles.
MINT_WEBHOOK_SECRET=

# Operator credential. Guards /admin/** and the authenticated actuator endpoints
# (/actuator/metrics, /actuator/prometheus). Prometheus needs matching basic_auth to scrape.
MINT_ADMIN_PASSWORD=

# Restrict to the wallet origins that actually need browser access. Leaving this unset allows
# any origin, which is acceptable for the public NUT surface but is not what you want in prod.
CASHU_MINT_CORS_ALLOWED_ORIGINS=

# --- Ports and versions ----------------------------------------------------------------------
CASHU_MINT_PORT=7777
CASHU_MINT_MANAGEMENT_PORT=9000
CASHU_VAULT_PORT=3333
PAYMENT_ADAPTER_PORT=8080
CASHU_MINT_VERSION=latest
CASHU_VAULT_VERSION=latest
