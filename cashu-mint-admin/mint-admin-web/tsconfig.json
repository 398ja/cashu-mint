{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  // The vendored NAP packages ship raw TypeScript and are typechecked upstream
  // under their own, looser options. The resolution test is the only file in
  // src that imports them, so excluding it keeps them out of this program —
  // otherwise the app's stricter options (noUncheckedIndexedAccess) land on
  // code we do not own and must not patch. See vendor/VENDORED.md. Vitest does
  // not read this exclude, so the test still runs.
  "exclude": ["src/vendorResolution.test.ts"]
}
