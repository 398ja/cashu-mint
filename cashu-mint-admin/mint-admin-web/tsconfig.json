{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // Off since #375, when the app started importing the vendored NAP packages.
    // They ship raw TypeScript, so they compile under these options, and four
    // spots in nap-core/src/codec.ts do not survive this one. Patching them is
    // not on the table (vendor/VENDORED.md), and building them to .d.ts would
    // put generated artifacts in a tree whose whole sync story is a directory
    // swap. The cost is index access in src no longer widening to undefined.
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
