# Base images for services with no client library in this reactor.
#
# Deliberately not a version list for anything we build or link against:
#   - cashu-mint-rest and mint-admin-rest are built here by jib and referenced
#     as ${PROJECT_VERSION}
#   - cashu-vault-jpa and payment-adapter-rest are pulled at the versions their
#     client libraries are declared at in the root pom, so service and client
#     stay in lockstep
# Pinning either independently is what left this stack testing a release from
# several versions back.
#
# POSTGRES_VERSION is a database major version rather than one of our artefacts,
# so it stays fixed — "latest" would move the engine underneath the schema.
POSTGRES_VERSION=16
PHOENIXD_VERSION=latest
VAULT_VERSION=latest
