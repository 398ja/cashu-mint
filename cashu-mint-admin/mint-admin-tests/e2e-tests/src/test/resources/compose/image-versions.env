POSTGRES_VERSION=16
CASHU_VAULT_VERSION=0.6.0
PAYMENT_ADAPTER_VERSION=0.8.0
PHOENIXD_VERSION=0.1.4
# NOTE: 0.12.2 predates cashu-mint #346, which moved actuator off the public API
# port onto management.server.port (9000). This stack's mint healthcheck and
# DockerComposeE2EStack's Wait.forHttp both probe /actuator/health/readiness on
# 7777, which is correct for THIS image. When you bump this pin past 0.27.0,
# retarget both to port 9000 or they will hang until STARTUP_TIMEOUT.
CASHU_MINT_VERSION=0.12.2
CASHU_MINT_ADMIN_VERSION=0.1.11
